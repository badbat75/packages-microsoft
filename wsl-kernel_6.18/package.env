# wsl-kernel_6.18
PKG_SUFFIX=.40.1
PKG_URL="https://github.com/microsoft/WSL2-Linux-Kernel/archive/refs/tags/linux-msft-wsl-6.18${PKG_SUFFIX}.tar.gz"
### depmod of modules_install
PKG_DEPS="lfs/kmod:native"
### libcrypto for extract-cert and sign-file, host programs of the build (kernelbuild: HOSTPKG_CONFIG)
PKG_DEPS+=" lfs/openssl:native"
BUILD_PROCESS=kernelbuild
### The Microsoft defconfig of each architecture is selected by variants/arch/, the extra
### filesystems by WITH_EXTOPTS (on by default) and the realtime kernel by WITH_RT
WITH_EXTOPTS=${WITH_EXTOPTS:-1}
